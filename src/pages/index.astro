---
import Layout from '../layouts/Layout.astro';
import Catalogue from '../components/Catalogue.astro';

const BASE_PRODUCTS_MOCK = [
  {
    sku: 'LF-APRIC-12X310G',
    name: 'La Favorita Apricots with Moscato Wine',
    description: 'Product of Italy',
    caseSize: '12x310g',
    price: 92.88,
    img: '/img/La-Favorita-Apricots-with-Moscato-Wine (1).jpg',
  },
  {
    sku: 'GF-DRFIG-20X500G',
    name: 'Good Fig Dried Figs',
    description: 'Calabazita variety of Figs. Tender and all natural. Gluten, and Sulphites free.',
    caseSize: '20x500g',
    price: 116.00,
    img: '/img/GF-Dried-Figs.jpg',
  },
  {
    sku: 'SDJ-1573-EVOO-9X500ML',
    name: 'Señorío DJR 1573 Extra Virgin Olive Oil',
    description: 'Exclusive reserva extravirgin olive oil brought exclusively for the holidays. This oil is the result of combining different varieties of olives such as the Arbequina Verde, Arbequina Madura and local varieties of the area: Alfafarenca,Blanqueta and Manzanilla.<br>No mechanical equipment is used for the harvest, olives are picked manually and transported immediately to the mill to extract the precious oil.<br>Product of Spain.',
    caseSize: '9x500ml',
    price: 241.65,
    img: '/img/Senorio-DJR-1573-EVOO-1.jpg',
  },
  {
    sku: 'PAN-DPAN-4X950G',
    name: 'Pancracio Dark Chocolate Panettone',
    description: 'Level up your Holiday offers, with this sourdough Panettone. Prepared in small batches, with the exclusive ÚNICO Pancracio 68% cocoa coating, made from the best Criollo and Trinitario beans, mixing them to obtain a fruity chocolate with a slight acid note.<br>NO TRANSFATTY ACIDS/PRESERVATIVES ADDED.<br>Product of Spain.',
    caseSize: '4x950g',
    price: 245.96,
    img: '/img/Pancracio-Dark-Chocolate-Pannetone-e1668454992856 (1).jpg',
  }
];

let finalProducts = BASE_PRODUCTS_MOCK;
try {
  let rawApiUrl = import.meta.env.WC_API_URL || (typeof process !== 'undefined' ? process.env.WC_API_URL : '');
  const WC_CONSUMER_KEY = import.meta.env.WC_CONSUMER_KEY || (typeof process !== 'undefined' ? process.env.WC_CONSUMER_KEY : '');
  const WC_CONSUMER_SECRET = import.meta.env.WC_CONSUMER_SECRET || (typeof process !== 'undefined' ? process.env.WC_CONSUMER_SECRET : '');

  if (rawApiUrl) {
    // Limpiamos cualquier prefijo mal escrito (como ttps:// o http://)
    rawApiUrl = rawApiUrl.replace(/^https?:\/\//i, '').replace(/^ttps?:\/\//i, '');
  }
  const WC_API_URL = rawApiUrl ? 'https://' + rawApiUrl.replace(/\/$/, '') : '';


  let sheetData = [];
  try {
    const sheetUrl = "https://docs.google.com/spreadsheets/d/e/2PACX-1vQ7-rPVnOyorDjjqfvIaOyDn4k_C7VYkzPQPi6XSkP88qIgSLUGF2TGedKos7HgFMp49J-mJaTPnUUW/pub?output=csv";
    const sheetRes = await fetch(sheetUrl);
    if (sheetRes.ok) {
      const csvText = await sheetRes.text();
      const lines = csvText.split(/\r?\n/);
      
      const parseCsvLine = (line) => {
        let arr = [];
        let quote = false;
        let val = '';
        for (let i = 0; i < line.length; i++) {
          let c = line[i], nc = line[i+1];
          if (c === '"' && quote && nc === '"') { val += '"'; i++; }
          else if (c === '"') { quote = !quote; }
          else if (c === ',' && !quote) { arr.push(val); val = ''; }
          else { val += c; }
        }
        arr.push(val);
        return arr;
      };

      if (lines.length > 0) {
        const headers = parseCsvLine(lines[0]).map((h) => h.trim().toLowerCase());
        const skuIdx = headers.findIndex((h) => h.includes('sku'));
        const upcIdx = headers.findIndex((h) => h.includes('upc'));
        const nameIdx = headers.findIndex((h) => h.includes('name'));
        const srpIdx = headers.findIndex((h) => h.includes('srp'));
        
        if (srpIdx >= 0) {
          for (let i = 1; i < lines.length; i++) {
            if (!lines[i].trim()) continue;
            const row = parseCsvLine(lines[i]);
            sheetData.push({
              sku: skuIdx >= 0 ? row[skuIdx]?.trim() : '',
              upc: upcIdx >= 0 ? row[upcIdx]?.trim() : '',
              name: nameIdx >= 0 ? row[nameIdx]?.trim() : '',
              srp: row[srpIdx]?.trim()
            });
          }
        }
      }
    }
  } catch (e) {
    console.error("Error fetching Google Sheet", e);
  }

  if (WC_API_URL && WC_CONSUMER_KEY && WC_CONSUMER_SECRET) {
    let page = 1;
    let totalPages = 1;
    let allData = [];

    const credentials = Buffer.from(`${WC_CONSUMER_KEY}:${WC_CONSUMER_SECRET}`).toString('base64');
    const headers = {
      'Authorization': `Basic ${credentials}`,
      'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',
      'Accept': 'application/json'
    };

    let fetchError = null;
    let fetchErrorText = '';

    while (page <= totalPages) {
      const fetchUrl = `${WC_API_URL}/products?per_page=100&page=${page}&status=publish&orderby=menu_order&order=asc`;
      console.log(`[WC API] Fetching page ${page} from ${fetchUrl}`);
      
      const res = await fetch(fetchUrl, { headers });

      if (!res.ok) {
        fetchErrorText = await res.text().catch(() => 'No text');
        fetchError = res.status;
        console.error(`[WC API] ERROR en página ${page}. Status: ${res.status}. Respuesta: ${fetchErrorText}`);
        break; // Stop fetching on error
      }

      const data = await res.json();
      allData = allData.concat(data);

      const totalPagesHeader = res.headers.get('x-wp-totalpages');
      if (totalPagesHeader) {
        totalPages = parseInt(totalPagesHeader, 10);
      } else {
        if (data.length < 100) break;
      }
      
      page++;
    }

    if (fetchError) {
      finalProducts = [{
        id: 'debug-1', sku: 'ERR-1', name: `API Error: Status ${fetchError}`, description: fetchErrorText.substring(0, 100), caseSize: 'N/A', price: 0, img: null, category: 'Error'
      }];
    } else if (allData.length > 0) {
      finalProducts = allData.reduce((acc: any[], item: any) => {
        const finalCategory = item.categories && item.categories.length > 0 
          ? item.categories[0].name.replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&#039;/g, "'").replace(/&quot;/g, '"')
          : "Uncategorized";

        if (finalCategory.toLowerCase().includes('seasonal')) {
          return acc;
        }

        let rawContent = (item.short_description || "") + " " + (item.description || "");
        let plainDesc = "";
        if (rawContent) {
          let preSpaced = rawContent.replace(/<br\s*\/?>/gi, " ").replace(/<\/p>/gi, " ");
          plainDesc = preSpaced.replace(/<\/?[^>]+(>|$)/g, " ").replace(/\s+/g, " ").trim();
          plainDesc = plainDesc.replace(/^[\.,\-\s]+|[\.,\-\s]+$/g, "");
        }

        let caseSize = "N/A";
        
        if (plainDesc) {
          const caseRegex = /Case(?:\s*[Ss]i[sz]e)?\s*:\s*([0-9\.\-]+(?:[xX×\s]+[0-9\.\-]+)?\s*[a-zA-Z]*)/i;
          const match = plainDesc.match(caseRegex);
          if (match && match[1]) {
            caseSize = match[1].trim();
          } else {
            const caseAttr = item.attributes?.find((a: any) => 
              a.name.toLowerCase() === 'case size' || a.name.toLowerCase() === 'casesize'
            );
            if (caseAttr && caseAttr.options?.length > 0) {
              caseSize = caseAttr.options[0];
            } else {
              const weightRegex = /([0-9\.\-]+\s*(?:kg|kilo|g|gr|ml|L)s?(?:\s*x\s*[0-9]+)?|[0-9]+\s*x\s*[0-9\.\-]+\s*(?:kg|kilo|g|gr|ml|L)s?)/i;
              const weightMatch = plainDesc.match(weightRegex);
              if (weightMatch && weightMatch[1]) {
                caseSize = weightMatch[1].trim();
              }
            }
          }
        }

        let finalPrice = parseFloat(item.price) || 0;

        if (finalPrice > 0) {
          let upc = item.global_unique_id || "";
          if (!upc && item.meta_data && Array.isArray(item.meta_data)) {
            const upcMeta = item.meta_data.find((m: any) => 
              m.key === '_wpm_gtin_code' || m.key === '_alg_ean' || m.key === '_gtin' || m.key === '_upc' || m.key === '_barcode' || m.key === 'hwp_var_gtin' || m.key === 'gtin' || m.key === '_ts_gtin'
            );
            if (upcMeta && upcMeta.value) {
              upc = upcMeta.value;
            }
          }

          const itemSku = item.sku || `WC-${item.id}`;
          const itemName = item.name ? item.name.replace(/&amp;/g, '&') : '';
          
          let srp = null;
          if (sheetData && sheetData.length > 0) {
            const sheetMatch = sheetData.find((s: any) => 
              (s.sku && s.sku === itemSku) ||
              (s.upc && s.upc === itemSku) || 
              (s.name && s.name.toLowerCase().includes(itemName.toLowerCase())) ||
              (s.name && itemName.toLowerCase().includes(s.name.toLowerCase()))
            );
            if (sheetMatch) {
              if (sheetMatch.srp) {
                srp = sheetMatch.srp;
              }
              if (sheetMatch.upc) {
                upc = sheetMatch.upc;
              }
            }
          }

          const mappedProd = {
            id: item.id,
            sku: itemSku,
            upc: upc,
            name: itemName,
            description: plainDesc,
            caseSize: caseSize,
            price: finalPrice,
            srp: srp,
            img: item.images && item.images.length > 0 ? item.images[0].src : null,
            category: finalCategory,
            brand: item.brands && item.brands.length > 0
              ? item.brands[0].name
              : (item.attributes?.find((a: any) => a.name.toLowerCase() === 'brand')?.options?.[0] || null)
          };
          acc.push(mappedProd);
        }
        return acc;
      }, []);

      console.log(`[WC API] ${finalProducts.length} productos procesados correctamente.`);
    } else {
      console.warn(`[WC API] WooCommerce devolvió un array vacío. Usando mock data.`);
    }
  } else {
    finalProducts = [{
      id: 'debug-2', sku: 'ERR-2', name: `Missing Env Vars: URL=${!!WC_API_URL} KEY=${!!WC_CONSUMER_KEY} SECRET=${!!WC_CONSUMER_SECRET}`, description: 'Check Vercel env vars', caseSize: 'N/A', price: 0, img: null, category: 'Error'
    }];
  }
} catch (error: any) {
  console.error('[WC API] Excepción atrapada.', error);
  const cause = error.cause ? error.cause.toString() : 'No cause attached';
  finalProducts = [{
    id: 'debug-3', sku: 'ERR-3', name: `Fetch failed`, description: `Cause: ${cause} | Msg: ${error.message}`, caseSize: 'N/A', price: 0, img: null, category: 'Error'
  }];
}
---

<Layout title="Fiore Foods - Product Catalogue">

  <!-- ════════════════════════════════════════════════════════════
       2 · HERO — SPLIT LAYOUT
  ════════════════════════════════════════════════════════════════ -->
  <section class="flex flex-col sm:flex-row overflow-hidden min-h-[auto] sm:min-h-[500px] sm:max-h-[600px]">
    <div class="relative flex items-center justify-center text-center w-full sm:w-5/12 px-6 sm:px-10 md:px-14 py-10 sm:py-14 flex-shrink-0 min-h-[250px] sm:min-h-[500px]" style="background:#80131d; overflow:hidden;">
      <!-- Olive plant: doubled size, bleeding off the left -->
      <div class="absolute inset-0 flex items-end justify-start pointer-events-none" style="overflow:visible;">
        <img src="img/olives-4 (1).png" alt="" class="parallax parallax-1" style="width:28rem; opacity:0.22; margin-bottom:-1rem; margin-left:-4rem;">
      </div>
      <div class="relative z-10 max-w-xs mx-auto">
        <h1 class="font-cap text-white leading-snug mb-4" style="font-size:clamp(18px,3.5vw,32px)">
          Explore Our Full Product Catalogue
        </h1>
        <a href="#catalogue" class="inline-block px-5 py-2.5 mt-2 rounded-full font-rob text-sm font-bold tracking-widest uppercase transition-all hover:opacity-90 hover:shadow-lg" style="background:white; color:#80131d;">
          Our Selection
        </a>
      </div>
    </div>
    <!-- Desktop Image -->
    <div class="hidden sm:block relative flex-1 overflow-hidden">
      <img src="/img/banner-fiore-foods-canada.webp" alt="Specialty gourmet foods spread" class="absolute inset-0 w-full h-full object-cover object-center">
    </div>
    <!-- Mobile Image -->
    <div class="block sm:hidden w-full h-64 relative overflow-hidden flex-shrink-0">
      <img src="/img/banner-fiore-foods-canada-mobile.webp" alt="Specialty gourmet foods spread" class="absolute inset-0 w-full h-full object-cover object-center">
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       3 · INSTRUCTION BANNER
  ════════════════════════════════════════════════════════════════ -->
  <section style="background:#acb370">
    <div class="max-w-5xl mx-auto px-6 py-8">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-center gap-6 sm:gap-0">
        <div class="flex items-center justify-start gap-4 sm:flex-1 sm:justify-center w-full">
          <div class="w-12 h-12 rounded-full flex items-center justify-center font-cap font-bold flex-shrink-0" style="background:rgba(255,255,255,.25); color:#fff; font-size:1.4rem">1</div>
          <div class="text-left">
            <p class="font-cap text-white text-lg font-bold">Select Products</p>
            <p class="text-white/70 text-base font-rob">Choose case quantities from the catalogue</p>
          </div>
        </div>
        <div class="arrow-step hidden sm:block px-3">›</div>
        <div class="flex items-center justify-start gap-4 sm:flex-1 sm:justify-center w-full">
          <div class="w-12 h-12 rounded-full flex items-center justify-center font-cap font-bold flex-shrink-0" style="background:rgba(255,255,255,.25); color:#fff; font-size:1.4rem">2</div>
          <div class="text-left">
            <p class="font-cap text-white text-lg font-bold">Enter Your Info</p>
            <p class="text-white/70 text-base font-rob">Fill in your contact &amp; company details</p>
          </div>
        </div>
        <div class="arrow-step hidden sm:block px-3">›</div>
        <div class="flex items-center justify-start gap-4 sm:flex-1 sm:justify-center w-full">
          <div class="w-12 h-12 rounded-full flex items-center justify-center font-cap font-bold flex-shrink-0" style="background:rgba(255,255,255,.25); color:#fff; font-size:1.4rem">3</div>
          <div class="text-left">
            <p class="font-cap text-white text-lg font-bold">Send Pre-Order</p>
            <p class="text-white/70 text-base font-rob">Submit — we'll prepare your Sales Order</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-12 text-center">
    <p class="text-[18px] font-rob text-gray-700 leading-relaxed">
      <strong style="color:#80131d">Fiore Foods</strong> is a specialty food distributor located in Toronto, Ontario. 
      We are committed to providing the finest products from around the world.
    </p>
  </section>

  <Catalogue products={finalProducts} />

  <!-- ════════════════════════════════════════════════════════════
       5 · ABOUT SECTION
  ════════════════════════════════════════════════════════════════ -->
  <section class="relative overflow-hidden py-20" style="background:#f5f3ef">
    <div class="botanical-float" aria-hidden="true">
      <img src="img/thyme.png" alt="Decoración de fondo" class="parallax parallax-2 w-[260px] opacity-100">
    </div>
    <div class="relative max-w-7xl mx-auto px-6 z-10">
      <div class="grid lg:grid-cols-2 gap-14 items-center">
        <div>
          <p class="font-rob text-xs font-medium mb-2" style="color:#a81624; letter-spacing:.05em">Good taste</p>
          <h2 class="font-cap leading-snug mb-5" style="color:#a81624; font-size:clamp(20px,2.5vw,28px)">
            WE ARE QUALITY,<br>COMMITMENT,<br>RESPONSIBILITY AND<br>EXPERTISE
          </h2>
          <p class="font-rob font-medium text-base lg:text-lg leading-relaxed mb-4" style="color:#a81624">
            Fiore Foods results from our family's passion for delicious food and the vision of having the most specialized gourmet products, straight from the Mediterranean.
          </p>
          <p class="font-rob text-base lg:text-lg leading-relaxed text-gray-600 mb-3">
            We are an ever-growing team committed to sourcing high-quality and diverse food products to specialty food stores, Cheese Shops, Restaurants, Online markets and more.
          </p>
          <p class="font-rob text-base lg:text-lg leading-relaxed text-gray-600 mb-3">
            Our portfolio includes from tasty and savoury snacks to the most exquisite artisan sweets.
          </p>
          <p class="font-rob text-base lg:text-lg font-bold mb-7" style="color:#80131d">
            Your customers will fall in love with our collections.
          </p>
          <button onclick="document.getElementById('catalogue')?.scrollIntoView({behavior: 'smooth'})" class="btn btn-red px-8 py-3 text-sm font-cap tracking-wide">
            GET STARTED
          </button>
        </div>
        <div class="relative h-[440px]">
          <div class="absolute top-0 left-0 w-[62%] h-[62%] rounded-2xl overflow-hidden shadow-lg">
            <img src="img/pic-fiore-foods-2.jpg" alt="Gourmet Mediterranean food spread" class="w-full h-full object-cover">
          </div>
          <div class="absolute bottom-0 right-0 w-[58%] h-[62%] rounded-2xl overflow-hidden shadow-lg" style="border:4px solid #f5f3ef">
            <img src="img/fiore-foods-mediterraneo-fot-02.jpg" alt="Olive grove harvesting" class="w-full h-full object-cover">
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
